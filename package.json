{
  "name": "vlezet",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "validate:m7-docs": "node scripts/validate-m7-docs.mjs",
    "benchmark:recognition:core": "node tools/recognition-benchmark/run-core.mjs",
    "benchmark:recognition:source-score": "npm --prefix tools/recognition-benchmark run score:source",
    "benchmark:recognition:real-source-score": "node tools/recognition-benchmark/run-real-source-score.mjs",
    "benchmark:recognition:m7-8c-gate": "node tools/recognition-benchmark/m7-8c-opening-gate.mjs",
    "benchmark:recognition:ai-proposal-gate": "node tools/recognition-benchmark/ai-proposal-gate.mjs",
    "benchmark:recognition:ai-proposal-qualify": "node tools/recognition-benchmark/ai-benchmark/proposal-qualification.mjs",
    "benchmark:recognition:real:generate": "node tools/recognition-benchmark/generate-real-fixture-assets.mjs",
    "benchmark:recognition:real:verify": "node tools/recognition-benchmark/verify-real-fixtures.mjs",
    "benchmark:recognition:real:gate": "node tools/recognition-benchmark/real-fixture-gate.mjs",
    "benchmark:recognition:ai": "node tools/recognition-benchmark/ai-benchmark/run.mjs",
    "benchmark:recognition:evidence": "node tools/recognition-benchmark/run-evidence.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "turbo": "2.10.5",
    "typescript": "6.0.3"
