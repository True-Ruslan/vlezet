{
  "name": "vlezet",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "coverage": "node tools/testing-policy/run-coverage.mjs",
    "coverage:baseline": "node tools/testing-policy/update-baseline.mjs",
    "coverage:check": "node tools/testing-policy/check-coverage.mjs",
    "verify:policy": "node tools/testing-policy/check-policy.mjs && node tools/testing-policy/check-coverage.mjs",
    "test:policy": "node --test tools/testing-policy/*.test.mjs",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "validate:m7-docs": "node scripts/validate-m7-docs.mjs",
    "benchmark:recognition:core": "node tools/recognition-benchmark/run-core.mjs",
    "benchmark:recognition:source-score": "npm --prefix tools/recognition-benchmark run score:source",
    "benchmark:recognition:evidence": "node tools/recognition-benchmark/run-evidence.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "turbo": "2.10.5",
    "typescript": "6.0.3"
  }
}
